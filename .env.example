# Copy this file to .env and fill in real values. Never commit .env.

# WhatsApp number customers use to contact support/sales, in international format, no + or spaces.
VITE_WHATSAPP_NUMBER=2348022559002

# Bank accounts shown to customers at checkout. Supports up to two accounts;
# leave VITE_BANK_2_* blank/unset if you only need one.
VITE_BANK_1_NAME="Your Bank Name"
VITE_BANK_1_ACCOUNT_NAME="Explogs Marketplace"
VITE_BANK_1_ACCOUNT_NUMBER="0000000000"

VITE_BANK_2_NAME=""
VITE_BANK_2_ACCOUNT_NAME=""
VITE_BANK_2_ACCOUNT_NUMBER=""

# Admin login. Must be a real email/password — the first successful login with
# this email bootstraps the Firebase Auth admin account (see src/context/AdminAuthContext.jsx).
VITE_ADMIN_EMAIL=admin@explogs.com
VITE_ADMIN_PASSWORD=change-me

# Cloudinary unsigned upload only. The upload preset must be configured as
# "Unsigned" in the Cloudinary dashboard. Never put CLOUDINARY_API_SECRET in
# a VITE_ variable — that would ship it to the browser.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default

# Firebase project config (from Firebase console > Project settings > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
